<?xml version="1.0" encoding="utf-8"?>
<!-- Explicit bottom-navigation colours: the selected tab is green, the others grey.
     Set on the BottomNavigationView so the icons and labels stay visible on the
     white bar no matter what theme or dark-mode setting the device uses. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/green_700" android:state_checked="true" />
    <item android:color="@color/grey_600" />
</selector>
