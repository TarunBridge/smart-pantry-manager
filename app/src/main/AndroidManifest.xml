<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Screen 1: Pantry List (launcher screen) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/title_pantry">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Screen 2: Add / Edit Ingredient -->
        <activity
            android:name=".ui.AddEditIngredientActivity"
            android:exported="false"
            android:label="@string/title_add_ingredient"
            android:parentActivityName=".ui.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Screen 3: Suggested Recipes -->
        <activity
            android:name=".ui.SuggestedRecipesActivity"
            android:exported="false"
            android:label="@string/title_suggested_recipes"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Screen 4: Recipe Detail -->
        <activity
            android:name=".ui.RecipeDetailActivity"
            android:exported="false"
            android:label="@string/title_recipe_detail"
            android:parentActivityName=".ui.SuggestedRecipesActivity" />
    </application>

</manifest>
